{
  "flow_id": "orchestrator-test-standard-v1",
  "description": "Five-stage standard flow used to test generic orchestrator routing and failure behavior.",
  "steps": [
    { "stage": "receiving" },
    { "stage": "prep", "when": { "route": ["fba"] } },
    { "stage": "pack", "when": { "route": ["mfn"] } },
    { "stage": "returns", "when": { "returned": [true] } },
    { "stage": "recovery" }
  ],
  "defaults": {
    "timeout_s": 30,
    "retries": 1,
    "on_uncertain": "continue",
    "on_error": "continue"
  }
}
