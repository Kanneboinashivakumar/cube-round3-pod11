{
  "flow_id": "cube-commerce-v1",
  "description": "Event-driven commerce lifecycle: receipt, route-specific Prep or Pack, physical return, then charge recovery.",
  "steps": [
    { "stage": "receiving" },
    { "stage": "prep", "when": { "route": ["fba"] } },
    { "stage": "pack", "when": { "route": ["mfn"] } },
    { "stage": "returns", "when": { "returned": [true] } },
    { "stage": "recovery", "when": { "has_charge": [true] } }
  ],
  "defaults": {
    "timeout_s": 90,
    "retries": 1,
    "on_uncertain": "continue",
    "on_error": "continue"
  }
}
